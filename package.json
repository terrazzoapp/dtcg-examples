  "description": "Open source design systems, expressed as DTCG JSON",
  "keywords": [
    "carbon",
    "design system",
    "design tokens",
    "dtcg",
    "polaris",
    "primer",
    "sds",
    "spectrum",
    "w3c"
  ],
  "license": "MIT",
  "author": {
    "name": "Drew Powers",
    "email": "drew@pow.rs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/terrazzoapp/dtcg-examples"
  },
  "type": "module",
  "scripts": {
    "lint": "pnpm run --parallel \"/^lint:/\"",
    "lint:adobe": "tz check adobe-spectrum.resolver.json",
    "lint:apple": "tz check apple-hig.resolver.json",
    "lint:figma": "tz check figma-sds.resolver.json",
    "lint:github": "tz check github-primer.resolver.json",
    "lint:ibm": "tz check ibm-carbon.resolver.json",
    "lint:ms": "tz check microsoft-fluent.resolver.json",
    "lint:shopify": "tz check shopify-polaris.resolver.json"
  },
  "devDependencies": {
    "@carbon/colors": "^11.55.0",
    "@carbon/layout": "^11.56.0",
    "@carbon/type": "^11.64.0",
    "@fluentui/theme": "^2.7.2",
    "@terrazzo/cli": "^2.6.0",
    "@terrazzo/parser": "^2.6.0",
    "@types/node": "^26.2.0",
    "colorjs.io": "^0.7.1",
    "degit": "^3.6.6",
    "json5": "^2.2.3",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "tinyglobby": "^0.2.17"
  },
  "packageManager": "pnpm@10.28.0"
}
